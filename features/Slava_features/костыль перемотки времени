Переделал функцию, пока что выглядит так, оно устанавливает тайм файктор, запускает таймер и через 1 секунду возвращает игровое время как было, таким образом если main установить 10 время будет переноситься на ~8 часов

sak.main(10)
function main(scale)
  basic_time_factor = level.get_time_factor ()
  sak.starter (scale)
  sak.main_timer()
end
 
function starter(scale)
  local factor = scale * 2650
  level.set_time_factor(factor)
end
 
function main_timer()
   local iTimer = time_global() + 1*1000
   local function check_timer()
    return time_global() > iTimer
   end
   level.add_call(check_timer, stopper)
end

function stopper()
  level.set_time_factor(basic_time_factor)
end


