--Проверка на вещь
function prov() 
	return sak.have_item_namber("af_medusa",1)
end

--Вещь забирают
function zabral()
sak.out_item_namber("af_medusa",1)
end

--Вещь дают
function nagrada()
sak.create_items_actor("medkit",3)
sak.create_items_actor("bandage",5)
end
