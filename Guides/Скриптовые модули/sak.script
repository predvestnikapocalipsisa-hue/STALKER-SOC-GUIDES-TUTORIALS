-- ========== ВСПОМОГАТЕЛЬНЫЕ ==========

-- Считает предметы в инвентаре с опциональным предикатом
function count_items(actor, section, predicate)
    local count = 0
    actor:iterate_inventory(function(_, item)
        if item:section() == section and (not predicate or predicate(item)) then
            count = count + 1
        end
    end, actor)
    return count
end

-- ========== ПРОВЕРКА НАЛИЧИЯ ==========

function have_item_namber(section, need)
    return count_items(db.actor, section) >= need
end

function cond_have_item_namber(section, need)
    return count_items(db.actor, section, function(it) 
        return it:condition() >= 0.85 
    end) >= need
end

-- ========== СПАВН ==========

function create_items(npc, section, number)
    for i = 1, number do
        alife():create(section, npc:position(), npc:level_vertex_id(), npc:game_vertex_id(), npc:id())
    end
end

function create_items_actor(section, number)
    create_items(db.actor, section, number)
    news_manager.relocate_item(db.actor, "in", section)
end

function create_items_actor_nomsg(section, number)
    create_items(db.actor, section, number)
end

-- ========== УДАЛЕНИЕ ==========

function out_item_namber(section, need)
    for i = 1, need do
        local obj = db.actor:object(section)
        if obj then
            alife():release(alife():object(obj:id()))
        else
            break
        end
    end
    news_manager.relocate_item(db.actor, "out", section)
end

function out_item_namber_nomsg(section, need)
    for i = 1, need do
        local obj = db.actor:object(section)
        if obj then
            alife():release(alife():object(obj:id()))
        else
            break
        end
    end
end